{
  "expo": {
    "name": "Stark",
    "slug": "stark-user",
    "version": "1.2.2",
    "orientation": "portrait",
    "scheme": "stark",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/logo/FullLogo.png",
          "resizeMode": "contain",
          "imageWidth": 150
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/TT-Octosquares-Medium.ttf"
          ]
        }
      ],
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo/FullLogo.png",
          "color": "#000000"
        }
      ]
    ],
    "android": {
      "package": "com.starkcabs.stark",
      "googleServicesFile": "./google-services.json",
      "versionCode": 31,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "NOTIFICATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDZ3-iM9suiGVssgSjEdApgQXpXmDgvVAc"
        }
      }
    },
    "ios": {
      "supportsTablet": true,
      "icon": "...",
      "bundleIdentifier": "com.starkcabs.stark",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "AIzaSyDZ3-iM9suiGVssgSjEdApgQXpXmDgvVAc"
      }
    },
    "extra": {
      "eas": {
        "projectId": "3cf9105e-ca08-4cbc-964b-2040139bbcd9"
      },
      "router": {}
    },
    "owner": "stark-opc-pvt-ltd"
  }
}